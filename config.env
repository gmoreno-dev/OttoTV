# shellcheck shell=bash
# Build settings, read by build.sh.

PRODUCT_NAME="Otto TV"
VERSION="0.4.2"
ISO_BASENAME="otto-tv"
# The ISO's volume label: the name the USB stick shows on a computer. The
# initrd finds the boot media by it (ROOT=LABEL=... in the boot menu).
ISO_LABEL="OTTO_TV"

# Upstream image: LineageOS TV x86, x86_64_tv_go flavor.
# https://sourceforge.net/projects/lineageos-tv-x86/files/
# Leave the URL empty to pass a local ISO: ./build.sh path/to/upstream.iso
UPSTREAM_ISO_URL=""
# Pin the exact upstream build. build.sh prints the hash when this is empty.
UPSTREAM_ISO_SHA256="8e26daf92fd61731d24040f4ebd2a78af999be7d6a8149877ec550cc0ccbf7f4"

BOOT_TIMEOUT=5

# Appended to every boot entry. Uppercase VAR=value pairs become shell
# variables in Android's init.sh (and in our hooks):
#   SET_TZ_LOCATION  upstream: time zone
#   OTTO_LOCALE      ours: default language
#   OTTO_AUDIO       ours: "auto" (default) or "off" to skip HDMI detection
EXTRA_KERNEL_ARGS="SET_TZ_LOCATION=America/Sao_Paulo OTTO_LOCALE=pt-BR"
