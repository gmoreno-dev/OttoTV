#!/bin/bash
# shellcheck disable=SC2086,SC2001,SC2154,SC1091
set -e

# Otto TV's boot entries for installed systems. Upstream's BlissOS script
# (etc/calamares/scripts/10_blissos), with Otto TV's name and only the two
# entries people need: Otto TV, and Otto TV with safe video. Installed in
# place of upstream's by iso/scripts/9-otto; grub-mkconfig runs it.
