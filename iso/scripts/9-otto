# shellcheck shell=sh
# Otto TV: initrd-stage hook.
#
# The initrd `init` sources every file in /scripts/ of the boot media (or of
# the install folder, on an installed system), then calls post_detect(),
# which upstream never defines. That makes post_detect our extension point:
# it runs right before switch_root, after Android is mounted on /android or,
# in install mode, after the installer is set up on /install.
#
# Everything here only defines functions: this file is sourced before any of
# that is mounted. One exception, at the end: in install mode the installer
# is copied to RAM right away, before upstream mounts it.

# To the console and to the kernel log, so `dmesg | grep otto` on the
# running system shows what happened here too.
# To the kernel log only (dmesg | grep otto:): the screen shows Otto.
otto_msg() {
	echo "otto: $*" >"${OTTO_KMSG:-/dev/kmsg}" 2>/dev/null
}

# Prepend our hooks to /system/etc/init.sh by bind-mounting a patched copy
# over it. Upstream uses the same trick for its own XML overrides, and the
# bind survives switch_root.
#
otto_patch_initsh() {
	local orig=/android/system/etc/init.sh
	local hooks="/mnt/$SRC/otto/init-hooks.sh"
	local patched=/tmp/otto-init.sh

	[ -f "$orig" ] && [ -f "$hooks" ] || return 0
	{ cat "$hooks" && otto_hook_bootcomplete <"$orig"; } >"$patched" &&
		mount --bind "$patched" "$orig" &&
		otto_msg "init.sh hooks installed"
}

# Reads upstream's init.sh and adds a call to otto_bootcomplete_early as the
# first line of do_bootcomplete. Upstream ends do_bootcomplete by installing
# its bundled apps (on every boot in live mode, about 30 seconds) and only
# then calls post_bootcomplete; the Home key, our keyboard and the phone
# remote should work as soon as the home screen shows. If upstream changes
# shape, nothing is added and post_bootcomplete does the work, later.
otto_hook_bootcomplete() {
	awk '
		pending && /^[[:space:]]*[{][[:space:]]*$/ {
			print
			print "\totto_bootcomplete_early"
			pending = 0
			next
		}
		{ pending = 0 }
		/^(function[[:space:]]+)?do_bootcomplete[[:space:]]*[(][)][[:space:]]*$/ { pending = 1 }
		{ print }
	'
}

# Upstream's zram script evals every word of the kernel command line, and the
# BOOT_IMAGE=(hd96)/kernel that GRUB adds is a shell syntax error: the script
# dies before it turns zram on, so no machine gets compressed swap. Low-RAM
# laptops need it most. This makes it skip the same words init.sh skips.
otto_fix_zram_script() {
	awk '
		!done && /^[[:space:]]*[*]=[*][)][[:space:]]*$/ {
			match($0, /^[[:space:]]*/)
			indent = substr($0, 1, RLENGTH)
			print indent "BOOT_IMAGE=*|iso-scan/*|*.*=*)"
			print indent "\t;;"
			done = 1
		}
		{ print }
	'
}

otto_fix_zram() {
	local orig="${OTTO_ANDROID:-/android}/system/vendor/etc/init.zram.sh"
	local patched="${OTTO_TMP:-/tmp}/otto-init.zram.sh"

	[ -f "$orig" ] || return 0
	if grep -q 'BOOT_IMAGE=' "$orig"; then
		return 0 # fixed upstream
	fi
	otto_fix_zram_script <"$orig" >"$patched" &&
		mount --bind "$patched" "$orig" &&
		otto_msg "zram: fixed upstream's setup script"
}

# Our app (home screen, pairing screen, physical keyboard IME) goes in as a
# system app, so it is there from the first moment instead of after
# upstream installs its user apps. Upstream's home screen, if it lives in
# the same folder, is hidden in the same overlay (see otto_upstream_launchers;
# a second overlay on this one could go past the kernel's stacking limit).
otto_system_apps() {
	local target="${OTTO_ANDROID:-/android}/system/app"
	local extra="/mnt/$SRC/otto/system_app"
	local layer="${OTTO_TMP:-/tmp}/otto-system_app-whiteouts" lower="$extra" name hidden=""

	[ -d "$target" ] && [ -d "$extra" ] || return 0
	for name in $(otto_upstream_launchers "$target"); do
		mkdir -p "$layer"
		mknod "$layer/$name" c 0 0 && hidden="$hidden $name"
	done
	[ -n "$hidden" ] && lower="$layer:$extra"
	mount -t overlay -o "lowerdir=$lower:$target" overlay "$target" &&
		otto_msg "system apps added${hidden:+, hid$hidden}"
}

# Upstream's home screen, which our launcher (tvapp/, home/) replaces.
# Prints the folders in an app folder that hold it, matched by name since
# it isn't the same everywhere. OTTO_LAUNCHER=upstream keeps it.
# Usage: otto_upstream_launchers <app folder>
otto_upstream_launchers() {
	local app
	[ "${OTTO_LAUNCHER:-ours}" = upstream ] && return 0
	for app in "$1"/*[Ll]auncher*; do
		[ -d "$app" ] && echo "${app##*/}"
	done
}


# Once Android runs, the boot media itself is out of reach: upstream only
# bind-mounts its /boot folder (GRUB's) on Android's /boot. The ISO carries
# an empty /boot/otto for us, so our folder shows up as /boot/otto too,
# where the Android-side hooks find otto-remote. Installed systems get the
# same folder from our installer step.
otto_expose_runtime() {
	local mountpoint=/android/boot/otto
	if [ ! -d "$mountpoint" ]; then
		otto_msg "WARNING: no $mountpoint, the phone remote won't start"
		return 1
	fi
	mount --bind "/mnt/$SRC/otto" "$mountpoint" &&
		otto_msg "files available to Android at /boot/otto"
}

# Reads a key layout (.kl) on stdin and prints it with Esc sending Back.
# Laptop keyboards have no Back key, and Android TV apps rely on one.
otto_esc_to_back() {
	sed -E 's/^([[:space:]]*key[[:space:]]+1[[:space:]]+)ESCAPE([[:space:]].*)?$/\1BACK/'
}

# Applies otto_esc_to_back to the layouts keyboards get by default:
# Generic.kl, and Vendor_0001_Product_0001.kl (built-in PS/2 keyboards) when
# the system ships one. OTTO_ESC=escape on the kernel command line keeps Esc.
otto_keylayouts() {
	local dir=/android/system/usr/keylayout
	local out=/tmp/otto-keylayout
	local name

	if [ "${OTTO_ESC:-back}" != back ]; then
		otto_msg "keys: OTTO_ESC=$OTTO_ESC, Esc stays Esc"
		return 0
	fi
	[ -d "$dir" ] || return 0
	mkdir -p "$out"
	for name in Generic.kl Vendor_0001_Product_0001.kl; do
		[ -f "$dir/$name" ] || continue
		otto_esc_to_back <"$dir/$name" >"$out/$name" &&
			mount --bind "$out/$name" "$dir/$name" &&
			otto_msg "keys: Esc sends Back ($name)"
	done
}

# Upstream installs every APK in /system/etc/user_app on first boot. We
# lay a read-only overlay on that folder: our extra APKs on top, plus
# overlayfs whiteouts (0/0 character devices) hiding the APKs we drop.
otto_user_apps() {
	local target=/android/system/etc/user_app
	local extra="/mnt/$SRC/otto/user_app"
	local removed="/mnt/$SRC/otto/remove_apps.txt"
	local whiteouts=/tmp/otto-user_app-whiteouts
	local lower

	[ -d "$target" ] || return 0
	mkdir -p "$whiteouts"
	if [ -f "$removed" ]; then
		tr -d '\r' <"$removed" | while read -r apk; do
			case "$apk" in '' | '#'*) continue ;; esac
			mknod "$whiteouts/$apk" c 0 0 && otto_msg "hiding $apk"
		done
	fi

	lower="$whiteouts"
	[ -d "$extra" ] && lower="$lower:$extra"
	mount -t overlay -o "lowerdir=$lower:$target" overlay "$target" &&
		otto_msg "user apps adjusted"
}

# Hides entries of a read-only system folder behind overlayfs whiteouts.
# Usage: otto_hide <folder> <name>...
otto_hide() {
	local dir="$1" layer name
	shift
	[ $# -gt 0 ] && [ -d "$dir" ] || return 0
	layer="/tmp/otto-hide$(echo "$dir" | tr / -)"
	mkdir -p "$layer"
	for name in "$@"; do
		mknod "$layer/$name" c 0 0 || return 1
	done
	mount -t overlay -o "lowerdir=$layer:$dir" overlay "$dir"
}

# Upstream apps that speak for LineageOS instead of Otto TV, hidden with
# whiteouts wherever upstream keeps them:
#  - the setup wizard, which opens before the home screen with a Bluetooth
#    accessory search and a LineageOS features page. Otto TV replaces it:
#    Wi-Fi and the phone come from our "Connect phone" screen, Bluetooth
#    pairing stays in Settings, and init-hooks.sh marks setup as done.
#    OTTO_SETUP=wizard on the kernel command line keeps it;
#  - the LineageOS updater, which would offer LineageOS builds. Otto TV
#    updates with its own files (tools/device/update.sh, then a new ISO);
#  - the home screen (otto_upstream_launchers): Otto TV has its own. Its
#    copy in system/app, if any, is hidden by otto_system_apps.
otto_hide_upstream_apps() {
	local dir app found
	local sys="${OTTO_ANDROID:-/android}/system"
	[ "${OTTO_SETUP:-ours}" = wizard ] &&
		otto_msg "setup: OTTO_SETUP=wizard, keeping upstream's wizard"
	[ "${OTTO_LAUNCHER:-ours}" = upstream ] &&
		otto_msg "home: OTTO_LAUNCHER=upstream, keeping upstream's home screen"
	for dir in "$sys/priv-app" "$sys/system_ext/priv-app" "$sys/product/priv-app" \
		"$sys/system_ext/app" "$sys/product/app"; do
		found=""
		for app in "$dir"/*SetupWizard* "$dir"/Updater; do
			[ -e "$app" ] || continue
			case "${app##*/}" in
			*SetupWizard*) [ "${OTTO_SETUP:-ours}" = wizard ] && continue ;;
			esac
			found="$found ${app##*/}"
		done
		for app in $(otto_upstream_launchers "$dir"); do
			found="$found $app"
		done
		[ -n "$found" ] || continue
		# shellcheck disable=SC2086  # one word per app folder
		otto_hide "$dir" $found && otto_msg "hid$found"
	done
}

# Install mode boots a small Linux with the Calamares installer, which only
# copies the system image, kernel, initrd and recovery to disk. Its root is a
# writable overlay at this point, so we make it Otto TV's installer:
#  - our jobs: defaults for the pages we skip, before gen-img (it reads
#    them), and our files (otto-payload) right after it;
#  - four steps, like the design: welcome, disk, install, done. No data.img
#    page, no developer options, no summary, and no bootloader question
#    (always GRUB) when it starts;
#  - Otto's branding and Portuguese, erase-the-disk preselected;
#  - the installed boot menu: Otto TV's entries and theme, 5 s, the PC's
#    UEFI boot entry named OttoTV;
#  - its little desktop: Otto's wallpaper, no BlissOS logo or readme;
#  - a QML step list: this Calamares is a debug build whose widget sidebar
#    aborts on an icon it can't load (that's branding.desc's business);
#  - its last button restarts through otto-restart, which asks for the pen
#    drive to be taken out first (see otto_installer_to_ram).
# The cosmetic steps never stop an installation.
# Usage: otto_patch_installer <installer root> <our otto folder>
otto_patch_installer() {
	local root="$1" payload="$2"
	local inst="$payload/installer"
	local cal="$root/etc/calamares"
	local modules="$root/usr/lib/x86_64-linux-gnu/calamares/modules"
	local settings="$cal/settings.conf"

	[ -d "$inst/otto-payload" ] && [ -f "$settings" ] || return 0
	grep -q -- '- otto-payload$' "$settings" && return 0

	mkdir -p "$modules" &&
		cp -r "$inst/otto-payload" "$inst/otto-defaults" "$modules/" &&
		sed -i -e 's/^\( *\)- gen-img$/\1- otto-defaults\n&\n\1- otto-payload/' \
			-e '/^ *- dataimg$/d' -e '/^ *- options$/d' -e '/^ *- summary$/d' \
			"$settings" || return 1
	if ! grep -q -- '- otto-payload$' "$settings"; then
		otto_msg "WARNING: installer step not added (no gen-img in settings.conf)"
		return 1
	fi
	otto_msg "installer will copy the Otto TV files"

	mkdir -p "$cal/branding" "$cal/scripts"
	if cp -r "$inst/branding/otto" "$cal/branding/" 2>/dev/null; then
		sed -i 's/^branding: .*/branding: otto/' "$settings"
	fi
	sed -i 's/^initialPartitioningChoice: .*/initialPartitioningChoice: erase/' \
		"$cal/modules/partition.conf" 2>/dev/null

	# The installed system's boot menu.
	sed -i 's/^efiBootloaderId: .*/efiBootloaderId: "OttoTV"/' \
		"$cal/modules/bootloader.conf" 2>/dev/null
	if cp "$inst/10_otto" "$cal/scripts/10_otto" 2>/dev/null; then
		chmod 755 "$cal/scripts/10_otto"
		sed -i 's|^grub_bootcfg: .*|grub_bootcfg: "/etc/calamares/scripts/10_otto"|' \
			"$cal/modules/bootcfg.conf"
	fi
	sed -i -e 's/GRUB_TIMEOUT=10/GRUB_TIMEOUT=5/' \
		-e "s/GRUB_DISTRIBUTOR=BlissLabs/GRUB_DISTRIBUTOR='Otto TV'/" \
		-e 's/^\( *\)print("GRUB_TIMEOUT_STYLE=menu", file=grubConf)$/&\n\1print("GRUB_GFXMODE=1366x768,1280x720,1024x768,auto", file=grubConf)/' \
		"$modules/bootcfg/main.py" 2>/dev/null
	# bootcfg copies every theme here to the installed /boot/grub/themes.
	if [ -d "$inst/grub-theme" ]; then
		rm -rf "$root/usr/share/grub/themes"
		mkdir -p "$root/usr/share/grub/themes"
		cp -r "$inst/grub-theme" "$root/usr/share/grub/themes/otto"
	fi
	sed -i 's/^LABEL="UEFI Firmware Settings"$/LABEL="Configurações do computador (UEFI)"/' \
		"$root/etc/grub.d/30_uefi-firmware" 2>/dev/null

	# Starts by itself (from JWM's startup), on GRUB, in Portuguese.
	sed -i 's/^calamares "\$@"$/LANG=pt_BR.UTF-8 LANGUAGE=pt_BR calamares "$@"/' \
		"$root/usr/bin/aaropa-calamares" 2>/dev/null
	mkdir -p "$root/etc/otto" &&
		cp "$inst/branding/otto/icon.png" "$root/etc/otto/icon.png" 2>/dev/null
	sed -i -e 's|bash -c /usr/bin/aaropa-calamares|bash -c "/usr/bin/aaropa-calamares grub"|g' \
		-e 's|label="Install BlissOS"|label="Instalar o Otto TV"|' \
		-e 's|/etc/bliss/blissos_logo.svg|/etc/otto/icon.png|g' \
		-e '/label="README"/d' \
		-e 's|<Background type="[a-z]*">|<Background type="tile">|' \
		"$root/root/.jwmrc" 2>/dev/null
	sed -i -e 's|^Exec=.*|Exec=/usr/bin/bash -c "/usr/bin/aaropa-calamares grub"|' \
		-e 's|^Name=.*|Name=Instalar o Otto TV|' \
		-e 's|^GenericName=.*|GenericName=Instalador do Otto TV|' \
		-e 's|^Icon=.*|Icon=/etc/otto/icon.png|' \
		"$root/root/Desktop/calamares.desktop" 2>/dev/null
	rm -f "$root/root/Desktop/HOW_TO_USE.png" "$root/root/Desktop/readme.desktop"
	# Its wallpaper: Otto's tile, over every image its settings could point
	# at, tiled (with a TV plugged in, the desktop spans both screens).
	for f in "$root"/usr/share/backgrounds/*.png; do
		[ -f "$f" ] && cp "$inst/wallpaper.png" "$f" 2>/dev/null
	done
	sed -i 's/^WallpaperMode=.*/WallpaperMode=tile/' \
		"$root/root/.config/pcmanfm/default/settings.conf" 2>/dev/null

	# The restart at the end ("Reiniciar agora" stays checked by default).
	if mkdir -p "$root/usr/local/bin" &&
		cp "$inst/otto-restart" "$root/usr/local/bin/otto-restart" 2>/dev/null; then
		chmod 755 "$root/usr/local/bin/otto-restart"
		cp "$payload/otto-ascii.txt" "$root/etc/otto/otto-ascii.txt" 2>/dev/null
		sed -i 's|^restartNowCommand: .*|restartNowCommand: "/usr/local/bin/otto-restart"|' \
			"$cal/modules/finished.conf" 2>/dev/null
	fi
	return 0
}

# Install mode: the installer (a small Linux in install.sfs, under 300 MB)
# runs from RAM, so the pen drive can come out before the end without
# freezing it, and the last screen can ask for it to come out
# (otto-restart). Calamares, the desktop and the restart then never read
# from the stick again; only the copy of the system, while installing, does.
# Upstream's COPYTORAM=1 copies the whole stick, which needs its size in free
# RAM; this copies the installer only, when the RAM can spare it and still
# leave 1 GB to the installer. Otherwise it runs from the stick, as upstream's.
# Upstream mounts install.sfs (setup_install) after sourcing this file, from
# /mnt/$SRC/$INSTALL: the copy is bind-mounted there.
otto_installer_to_ram() {
	local src="${OTTO_MNT:-/mnt}/$SRC/$INSTALL"
	local ram="${OTTO_RAMDIR:-/otto-ram}"
	local copy size avail
	[ -f "$src" ] || return 0
	copy="$ram/${INSTALL##*/}"
	size=$(du -m "$src" | awk '{ print $1 }')
	avail=$(awk '/^MemAvailable:/ { print int($2 / 1024) }' "${OTTO_MEMINFO:-/proc/meminfo}")
	if [ "${avail:-0}" -lt $((size + 1024)) ]; then
		otto_msg "installer runs from the boot media (${avail:-?} MB of RAM free)"
		return 0
	fi
	mkdir -p "$ram" &&
		mount -t tmpfs -o "size=$((size + 16))m,mode=0755" otto-ram "$ram" || return 0
	if cp "$src" "$copy" && mount --bind "$copy" "$src"; then
		otto_msg "installer copied to RAM (${size} MB)"
	else
		otto_msg "WARNING: could not copy the installer to RAM"
		umount "$ram" 2>/dev/null
	fi
	return 0
}

# A first boot, which takes minutes: Android's data has no
# post_inst_complete yet (upstream writes it once its bundled apps are
# installed), or a live system, which starts from scratch every time.
# text_art, in the initrd's /init, decides the same way.
otto_first_boot() {
	local data="${OTTO_DATA:-/mnt/$SRC/data}"
	if [ -d "$data" ]; then
		[ ! -e "$data/vendor/post_inst_complete" ]
	else
		grep -q androidboot.live=true "${OTTO_CMDLINE:-/proc/cmdline}"
	fi
}

# Otto's boot animation over LineageOS's (it has a light and a dark one). On
# a first boot, the one that says it takes a few minutes.
otto_boot_animation() {
	local zip="/mnt/$SRC/otto/bootanimation.zip"
	local media="${OTTO_ANDROID:-/android}/system/product/media" f
	if otto_first_boot && [ -f "/mnt/$SRC/otto/bootanimation-first.zip" ]; then
		zip="/mnt/$SRC/otto/bootanimation-first.zip"
	fi
	[ -f "$zip" ] || return 0
	for f in bootanimation.zip bootanimation-dark.zip; do
		[ -f "$media/$f" ] && mount --bind "$zip" "$media/$f"
	done
	otto_msg "boot animation: ${zip##*/}"
}

# Boots from a hard disk spend most of their time waiting for the disk:
# Android reads several hundred MB of the system image and of /data in a
# scattered order, a seek each time. otto-remote's prefetcher reads what
# the last boot read, in disk order and long reads (remote/prefetch). With
# no list yet, it waits for the home screen (init-hooks.sh touches
# data/misc/otto/booted), notes what was read and exits.
#
# With a list, the boot waits up to OTTO_PREFETCH_HOLD seconds (12) while
# it reads: alone on the disk it reads at full speed, while Android's own
# scattered reads would make it seek (on the Acer, reading alongside Android
# managed a third of that). The rest is read alongside, and disk read-ahead
# goes up for the boot (init-hooks.sh puts it back). The prefetcher keeps
# running after switch_root: from the initrd's root it still sees the
# partition at /mnt.
#
# Only installed systems on hard disks: live ones boot from a stick, and an
# SSD doesn't seek. OTTO_PREFETCH=off turns it off.
otto_prefetch() {
	local dir="/mnt/$SRC" img q pid i dev rot bin="${OTTO_TMP:-/tmp}/otto-prefetch"
	local sys="${OTTO_SYSFS:-/sys}" list="/mnt/$SRC/otto/prefetch.list"
	[ "${OTTO_PREFETCH:-on}" = on ] || return 0
	[ -w "$dir/otto" ] && [ -f "$dir/otto/remote/otto-remote" ] || return 0
	# A first boot installs apps and compiles: nothing like the boots after it.
	otto_first_boot && return 0
	img=$(cat "$sys/block/loop0/loop/backing_file" 2>/dev/null)
	[ -f "$img" ] || return 0
	dev=$(awk '$2 == "/mnt" { sub("^/dev/", "", $1); print $1; exit }' "${OTTO_PROC:-/proc}/mounts")
	rot=$(cat "$sys/class/block/$dev/queue/rotational" "$sys/class/block/$dev/../queue/rotational" 2>/dev/null | head -n 1)
	if [ "$rot" = 0 ]; then
		otto_msg "prefetch: $dev is not a hard disk, not needed"
		return 0
	fi
	# A copy in RAM: the partition may be mounted noexec.
	cp "$dir/otto/remote/otto-remote" "$bin" && chmod 755 "$bin" || return 0
	(
		cd /
		exec "$bin" prefetch -list "$list" -ready "$dir/data/misc/otto/booted" "$img" "$dir/data.img" \
			"$dir/data/dalvik-cache" "$dir/data/misc/apexdata" "$dir/data/app" \
			"$dir/data/system" "$dir/data/system_de" "$dir/data/user_de"
	) </dev/null >/dev/null 2>&1 &
	pid=$!
	if [ ! -f "$list" ]; then
		otto_msg "prefetch: recording this boot ($(basename "$img"))"
		return 0
	fi
	for q in "$sys"/block/sd*/queue "$sys/block/loop0/queue"; do
		[ -w "$q/read_ahead_kb" ] && echo 2048 >"$q/read_ahead_kb"
	done
	i=0
	while [ "$i" -lt "${OTTO_PREFETCH_HOLD:-12}" ] && kill -0 "$pid" 2>/dev/null; do
		sleep 1
		i=$((i + 1))
	done
	otto_msg "prefetch: reading ($(basename "$img")), boot held ${i}s"
}

post_detect() {
	# Recovery never starts our Android: leave it alone.
	[ "$RCVRY" ] && return 0

	if [ "$INSTALL" ]; then
		# setup_install moved the boot media from /mnt to /install/cdrom.
		otto_patch_installer /install "/install/cdrom/$SRC/otto"
		return 0
	fi

	[ -d "/mnt/$SRC/otto" ] || return 0
	otto_patch_initsh
	otto_system_apps
	otto_user_apps
	otto_fix_zram
	otto_boot_animation
	otto_keylayouts
	otto_expose_runtime
	otto_hide_upstream_apps
	otto_prefetch
}

# Install mode, before upstream mounts the installer (otto_installer_to_ram).
# Upstream's COPYTORAM already puts everything in RAM.
if [ -n "${INSTALL:-}" ] && [ -z "${RCVRY:-}" ] &&
	{ [ -z "${COPYTORAM:-}" ] || [ "$COPYTORAM" = false ]; }; then
	otto_installer_to_ram
fi
