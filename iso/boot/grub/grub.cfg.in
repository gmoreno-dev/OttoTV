# @PRODUCT_NAME@ boot menu.
# Generated by build.sh from iso/boot/grub/grub.cfg.in. Based on the upstream
# LineageOS TV x86 menu; functions.cfg is upstream's, patched at build time.

insmod part_gpt
insmod part_msdos
insmod part_apple
insmod all_video
insmod regexp

set timeout=@BOOT_TIMEOUT@
set gfxpayload=keep

set TITLE="@PRODUCT_NAME@ @VERSION@"
# ROOT=LABEL must match the ISO volume label: the initrd finds the boot
# media by it. build.sh fills it in from the upstream ISO.
set KERNEL_ARGS="root=/dev/ram0 androidboot.live=true ROOT=LABEL=@ISO_LABEL@ @EXTRA_KERNEL_ARGS@"
set KERNEL=/kernel
set INITRD=/initrd.img

if [ "$RELOAD" != "true" ]; then
	source /boot/grub/functions.cfg
fi

if is_efi; then
	insmod efi_gop
	insmod efi_uga
fi

if [ "$root" == "loop0" ]; then
	set prefix=($root)/boot/grub
fi

insmod jpeg
insmod png
load_theme

if [ -z "$src" -a -n "$isofile" ]; then
	set iso="iso-scan/filename=$isofile"
fi

# Our defaults for the "Advanced options" toggles. Exported variables survive
# the menu reload each toggle triggers, so the guard keeps them togglable.
if [ -z "$otto_defaults" ]; then
	set otto_defaults=1
	export otto_defaults
	# Skip the Android TV setup wizard: it hangs looking for a Bluetooth
	# remote on PCs that have none.
	set setupwizard="SETUPWIZARD=0"
	export setupwizard
fi

add_entry "Iniciar"
# Software rendering, for GPUs the hardware drivers can't handle.
add_entry "Modo de compatibilidade:" "nomodeset HWACCEL=0"
add_entry "Instalar" "INSTALL=install.sfs"

submenu --class brunch-settings --class forward "Advanced options" {
	toggle_ffmpeg
	toggle_pcmode
	toggle_hwaccel
	toggle_setupwizard
	toggle_copytoram
}

efi_detect
memtest_detect
power_options
