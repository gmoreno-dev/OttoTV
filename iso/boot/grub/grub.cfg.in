# @PRODUCT_NAME@ boot menu (the USB stick's; installed systems get theirs from
# the installer, see iso/otto/installer). Rendered by build.sh from
# iso/boot/grub/grub.cfg.in. Self-contained: upstream's functions.cfg and its
# menu of developer toggles aren't used.

insmod part_gpt
insmod part_msdos
insmod all_video
insmod gfxterm
insmod gfxmenu
insmod png

set timeout=@BOOT_TIMEOUT@
set timeout_style=menu
set default=0
set gfxpayload=keep

# ROOT=LABEL must match the ISO's volume label: the initrd finds the boot
# media by it. quiet, loglevel=3 and the hidden cursor keep the screen clean
# until the boot animation: the initrd shows only Otto (tools/patch-initrd.sh).
set KERNEL_ARGS="root=/dev/ram0 androidboot.live=true ROOT=LABEL=@ISO_LABEL@ quiet loglevel=3 vt.global_cursor_default=0 SETUPWIZARD=0 @EXTRA_KERNEL_ARGS@"
set KERNEL=/kernel
set INITRD=/initrd.img

function is_efi {
	if [ "${grub_platform}" = "efi" ]; then
		return 0
	fi
	return 1
}

if is_efi; then
	insmod efi_gop
	insmod efi_uga
fi

# Booted from an ISO file (Ventoy, GRUB loopback): tell the initrd where it is.
if [ "$root" == "loop0" ]; then
	set prefix=($root)/boot/grub
fi
if [ -z "$src" -a -n "$isofile" ]; then
	set iso="iso-scan/filename=$isofile"
fi

# The theme is drawn for 1366x768 and placed relative to the screen, so the
# first mode the screen offers wins.
set gfxmode=1366x768,1280x720,1024x768,auto
terminal_output gfxterm
loadfont $prefix/themes/otto/inter-28.pf2
loadfont $prefix/themes/otto/inter-24.pf2
set theme=$prefix/themes/otto/theme.txt
export theme

menuentry "@PRODUCT_NAME@" --class otto {
	linux ($root)$KERNEL $KERNEL_ARGS "$iso"
	initrd ($root)$INITRD
}

menuentry "Instalar o @PRODUCT_NAME@ neste computador" --class otto {
	linux ($root)$KERNEL $KERNEL_ARGS INSTALL=install.sfs "$iso"
	initrd ($root)$INITRD
}

# Software rendering, for GPUs the hardware drivers can't handle.
menuentry "@PRODUCT_NAME@ em modo de vídeo seguro" --class otto {
	linux ($root)$KERNEL $KERNEL_ARGS nomodeset HWACCEL=0 "$iso"
	initrd ($root)$INITRD
}

if is_efi; then
	menuentry "Configurações do computador (UEFI)" --class otto {
		fwsetup
	}
fi
